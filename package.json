{
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm images:generate && nuxt build",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:output": "node --import tsx --test tests/output/*.test.ts",
    "test:e2e": "playwright test",
    "dev": "pnpm images:generate && nuxt dev",
    "generate": "pnpm images:generate && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write \"**/*.{vue,ts,js,mjs,json,md}\" --ignore-path .gitignore",
    "generate:experiment-thumbnail": "node scripts/generate-experiment-thumbnail.mjs"
  },
  "devDependencies": {
    "@comark/nuxt": "^0.7.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "feed": "^6.0.0",
    "gray-matter": "^4.0.3",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "shiki": "^4.4.3",
    "sitemap": "^9.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.11",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "chords.ts": "^0.1.0",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@10.8.0+sha512.0e82714d1b5b43c74610193cb20734897c1d00de89d0e18420aebc5977fa13d780a9cb05734624e81ebd81cc876cd464794850641c48b9544326b5622ca29971"
}
