[{"data":1,"prerenderedAt":187},["ShallowReactive",2],{"$f23lisnwa57rqk":3},{"title":4,"date":5,"tags":6,"categories":9,"draft":11,"_id":12,"slug":13,"path":14,"document":15,"excerpt":185,"readingTimeMinutes":186},"Upgrading the Firmware on the PCEngines APU2","2019-12-21T00:00:00.000Z",[7,8],"pcengine","apu",[10],"linux",false,"content:blog:apu2-firmware-upgrade","apu2-firmware-upgrade","\u002Fblog\u002Fapu2-firmware-upgrade",{"frontmatter":16,"meta":17,"nodes":18},{},{},[19,29,32,36,39,54,70,104,111,127,130,152,158],[20,21,22,23,28],"p",{},"I've had a ",[24,25,27],"a",{"href":26},"https:\u002F\u002Fpcengines.ch\u002Fapu2.htm","PCEngines APU2"," gathering dust for a\nfew years, and have recently decided to dust it off.",[20,30,31],{},"Since the last time the device has been powered on, there have been many great\nimprovements to the firmware, and it was very-much due for an upgrade. The\nfollowing steps outline how the firmware was upgraded on the APU from the\nalready-installed operating system -- CentOS.",[33,34,35],null,{},"more",[20,37,38],{},"First, we will connect to the device over the serial port",[40,41,43],"pre",{"class":42},"shiki shiki-themes tokyo-night dark:tokyo-night",[44,45,46],"code",{},[47,48,51],"span",{"class":49,"style":50},"line","display: inline",[47,52,53],{},"screen \u002Fdev\u002Ftty.usbserial 115200",[20,55,56,57,60,61,64,65,69],{},"Then, we will install the ",[44,58,59],{},"flashrom"," utility that is needed to update the\nfirmware. Because it is not available in the default ",[44,62,63],{},"yum"," repositories, we\nwill enable the ",[66,67,68],"em",{},"Extra Packages for Enterprise Linux"," (EPEL) repository before\ninstallation.",[40,71,73],{"language":72,"class":42},"bash",[44,74,76,92,93],{"class":75},"language-bash",[47,77,78,82,86,89],{"class":49,"style":50},[47,79,81],{"style":80},"color:#C0CAF5","sudo",[47,83,85],{"style":84},"color:#9ECE6A"," yum",[47,87,88],{"style":84}," install",[47,90,91],{"style":84}," epel-release","\n",[47,94,95,97,99,101],{"class":49,"style":50},[47,96,81],{"style":80},[47,98,85],{"style":84},[47,100,88],{"style":84},[47,102,103],{"style":84}," flashrom",[20,105,106,107,110],{},"Next, we will download the latest version of the firmware that is compatible\nwith the APU2 device from the PC Engines release website:\n",[24,108,109],{"href":109},"https:\u002F\u002Fpcengines.github.io\u002F",".",[40,112,113],{"language":72,"class":42},[44,114,115],{"class":75},[47,116,117,120,124],{"class":49,"style":50},[47,118,119],{"style":80},"curl",[47,121,123],{"style":122},"color:#E0AF68"," -O",[47,125,126],{"style":84}," https:\u002F\u002F3mdeb.com\u002Fopen-source-firmware\u002Fpcengines\u002Fapu2\u002Fapu2_v4.11.0.1.rom",[20,128,129],{},"And finally, we will flash the firmware...",[40,131,132],{"language":72,"class":42},[44,133,134],{"class":75},[47,135,136,138,140,143,146,149],{"class":49,"style":50},[47,137,81],{"style":80},[47,139,103],{"style":84},[47,141,142],{"style":122}," -w",[47,144,145],{"style":84}," apu2_v4.11.0.1.rom",[47,147,148],{"style":122}," -p",[47,150,151],{"style":84}," internal:boardmismatch=force",[20,153,154],{},[155,156,157],"strong",{},"References:",[159,160,161,166,170,175,180],"ul",{},[162,163,164],"li",{},[24,165,26],{"href":26},[162,167,168],{},[24,169,109],{"href":109},[162,171,172],{},[24,173,174],{"href":174},"https:\u002F\u002Fgithub.com\u002Fpcengines\u002Fapu2-documentation\u002Fblob\u002Fmaster\u002Fdocs\u002Ffirmware_flashing.md",[162,176,177],{},[24,178,179],{"href":179},"https:\u002F\u002Fgithub.com\u002Fpcengines\u002Fapu2-documentation\u002Fblob\u002Fmaster\u002Fdocs\u002Fcold_reset.md",[162,181,182],{},[24,183,184],{"href":184},"https:\u002F\u002Fgithub.com\u002Felad\u002Fopenbsd-apu2","I've had a PCEngines APU2 gathering dust for a few years, and have recently decided to dust it off. Since the last time the device has been powered on, there have been many great improvements to the firmware, and it was verymuch due for an upgrade. The following steps outline how the firmware was upgraded on the APU from the alreadyinstalled operating system CentOS.",1,1790632300769]