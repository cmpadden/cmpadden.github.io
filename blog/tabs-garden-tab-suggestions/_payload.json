,360],{"class":224},"=>",[14,362,279],{"class":66},[14,364,365,368,371,374,377,380,383,385],{"class":62,"line":173},[14,366,367],{"class":66},"    dot ",[14,369,370],{"class":224},"+=",[14,372,373],{"class":66}," value ",[14,375,376],{"class":224},"*",[14,378,379],{"class":66}," (right[key] ",[14,381,382],{"class":224},"??",[14,384,293],{"class":73},[14,386,387],{"class":66},");\n",[14,389,391,394,396,398,400],{"class":62,"line":390},11,[14,392,393],{"class":66},"    leftMagnitude ",[14,395,370],{"class":224},[14,397,373],{"class":66},[14,399,376],{"class":224},[14,401,402],{"class":66}," value;\n",[14,404,406],{"class":62,"line":405},12,[14,407,408],{"class":66},"  });\n",[14,410,412,414,417,420,422,425,427,430,432],{"class":62,"line":411},13,[14,413,333],{"class":66},[14,415,416],{"class":231},"values",[14,418,419],{"class":66},"(right).",[14,421,342],{"class":231},[14,423,424],{"class":66},"((",[14,426,354],{"class":243},[14,428,429],{"class":66},") ",[14,431,360],{"class":224},[14,433,279],{"class":66},[14,435,437,440,442,444,446],{"class":62,"line":436},14,[14,438,439],{"class":66},"    rightMagnitude ",[14,441,370],{"class":224},[14,443,373],{"class":66},[14,445,376],{"class":224},[14,447,402],{"class":66},[14,449,451],{"class":62,"line":450},15,[14,452,408],{"class":66},[14,454,456],{"class":62,"line":455},16,[14,457,328],{"emptyLinePlaceholder":327},[14,459,461,464,467,470,472,475,477,479,481,483,486,488],{"class":62,"line":460},17,[14,462,463],{"class":224},"  if",[14,465,466],{"class":66}," (leftMagnitude ",[14,468,469],{"class":224},"===",[14,471,293],{"class":73},[14,473,474],{"class":224}," ||",[14,476,316],{"class":66},[14,478,469],{"class":224},[14,480,293],{"class":73},[14,482,429],{"class":66},[14,484,485],{"class":224},"return",[14,487,293],{"class":73},[14,489,296],{"class":66},[14,491,493,496,498,501,504,507,510,512,515,517],{"class":62,"line":492},18,[14,494,495],{"class":224},"  return",[14,497,287],{"class":66},[14,499,500],{"class":224},"/",[14,502,503],{"class":66}," (Math.",[14,505,506],{"class":231},"sqrt",[14,508,509],{"class":66},"(leftMagnitude) ",[14,511,376],{"class":224},[14,513,514],{"class":66}," Math.",[14,516,506],{"class":231},[14,518,519],{"class":66},"(rightMagnitude));\n",[14,521,523],{"class":62,"line":522},19,[14,524,525],{"class":66},"};\n",[19,527,529],{"id":528},"building-the-tab-vector","Building the tab vector",[10,531,532],{},"Taking a step back, let's dig in to how we convert our tab metadata into a tab vector. Since our data is pretty messy, first, we normalize the chord symbols:",[27,534,536],{"className":215,"code":535,"language":217,"meta":33,"style":33},"canonicalizeChordSymbol(\"Dbmaj7/F\"); // \"C#:maj7\"\ncanonicalizeChordSymbol(\"Bbmin7\"); // \"A#:m7\"\ncanonicalizeChordSymbol(\"C/G\"); // \"C:maj\"\ncanonicalizeChordSymbol(\"N.C.\"); // null\n",[35,537,538,557,571,585],{"__ignoreMap":33},[14,539,540,543,546,550,553],{"class":62,"line":63},[14,541,542],{"class":231},"canonicalizeChordSymbol",[14,544,545],{"class":66},"(",[14,547,549],{"class":548},"sU2Wk","\"Dbmaj7/F\"",[14,551,552],{"class":66},"); ",[14,554,556],{"class":555},"sAwPA","// \"C#:maj7\"\n",[14,558,559,561,563,566,568],{"class":62,"line":70},[14,560,542],{"class":231},[14,562,545],{"class":66},[14,564,565],{"class":548},"\"Bbmin7\"",[14,567,552],{"class":66},[14,569,570],{"class":555},"// \"A#:m7\"\n",[14,572,573,575,577,580,582],{"class":62,"line":86},[14,574,542],{"class":231},[14,576,545],{"class":66},[14,578,579],{"class":548},"\"C/G\"",[14,581,552],{"class":66},[14,583,584],{"class":555},"// \"C:maj\"\n",[14,586,587,589,591,594,596],{"class":62,"line":99},[14,588,542],{"class":231},[14,590,545],{"class":66},[14,592,593],{"class":548},"\"N.C.\"",[14,595,552],{"class":66},[14,597,598],{"class":555},"// null\n",[10,600,601],{},"Then we define some hand-tuned weights from the various properties:",[27,603,605],{"className":215,"code":604,"language":217,"meta":33,"style":33},"export const TAB_SIMILARITY_WEIGHTS = {\n  genre: 3.5,\n  chord: 0.8,\n  progression: 1.2,\n  metadata: 0.8,\n  release: 2.4,\n  structure: 0.3,\n} as const;\n",[35,606,607,620,629,639,649,658,667,677],{"__ignoreMap":33},[14,608,609,611,613,616,618],{"class":62,"line":63},[14,610,225],{"class":224},[14,612,228],{"class":224},[14,614,615],{"class":73}," TAB_SIMILARITY_WEIGHTS",[14,617,235],{"class":224},[14,619,279],{"class":66},[14,621,622,625,627],{"class":62,"line":70},[14,623,624],{"class":66},"  genre: ",[14,626,80],{"class":73},[14,628,83],{"class":66},[14,630,631,634,637],{"class":62,"line":86},[14,632,633],{"class":66},"  chord: ",[14,635,636],{"class":73},"0.8",[14,638,83],{"class":66},[14,640,641,644,647],{"class":62,"line":99},[14,642,643],{"class":66},"  progression: ",[14,645,646],{"class":73},"1.2",[14,648,83],{"class":66},[14,650,651,654,656],{"class":62,"line":111},[14,652,653],{"class":66},"  metadata: ",[14,655,636],{"class":73},[14,657,83],{"class":66},[14,659,660,663,665],{"class":62,"line":123},[14,661,662],{"class":66},"  release: ",[14,664,144],{"class":73},[14,666,83],{"class":66},[14,668,669,672,675],{"class":62,"line":136},[14,670,671],{"class":66},"  structure: ",[14,673,674],{"class":73},"0.3",[14,676,83],{"class":66},[14,678,679,682,685,687],{"class":62,"line":149},[14,680,681],{"class":66},"} ",[14,683,684],{"class":224},"as",[14,686,228],{"class":224},[14,688,296],{"class":66},[10,690,691],{},"I started with chord and progression features weighted higher, but that surfaced too many generic four-chord matches. After looking at the first recommendations, I shifted more weight toward genre and release era.",[10,693,694],{},"For chord and progression features, we had to divide by the square root of the chord count. This keeps a long tab from winning just because it has more chord events.",[27,696,698],{"className":215,"code":697,"language":217,"meta":33,"style":33},"chords.forEach((chord) => {\n  addFeature(\n    vector,\n    `chord:${chord}`,\n    TAB_SIMILARITY_WEIGHTS.chord / Math.sqrt(uniqueChordCount),\n  );\n});\n\nsequence.slice(0, -1).forEach((chord, index) => {\n  const nextChord = sequence[index + 1];\n  if (!nextChord || chord === nextChord) return;\n  addFeature(\n    vector,\n    `progression:${chord}>${nextChord}`,\n    TAB_SIMILARITY_WEIGHTS.progression / Math.sqrt(totalChordCount),\n  );\n});\n",[35,699,700,718,726,731,743,760,765,770,774,813,835,863,869,873,890,906,910],{"__ignoreMap":33},[14,701,702,705,707,709,712,714,716],{"class":62,"line":63},[14,703,704],{"class":66},"chords.",[14,706,342],{"class":231},[14,708,424],{"class":66},[14,710,711],{"class":243},"chord",[14,713,429],{"class":66},[14,715,360],{"class":224},[14,717,279],{"class":66},[14,719,720,723],{"class":62,"line":70},[14,721,722],{"class":231},"  addFeature",[14,724,725],{"class":66},"(\n",[14,727,728],{"class":62,"line":86},[14,729,730],{"class":66},"    vector,\n",[14,732,733,736,738,741],{"class":62,"line":99},[14,734,735],{"class":548},"    `chord:${",[14,737,711],{"class":66},[14,739,740],{"class":548},"}`",[14,742,83],{"class":66},[14,744,745,748,751,753,755,757],{"class":62,"line":111},[14,746,747],{"class":73},"    TAB_SIMILARITY_WEIGHTS",[14,749,750],{"class":66},".chord ",[14,752,500],{"class":224},[14,754,514],{"class":66},[14,756,506],{"class":231},[14,758,759],{"class":66},"(uniqueChordCount),\n",[14,761,762],{"class":62,"line":123},[14,763,764],{"class":66},"  );\n",[14,766,767],{"class":62,"line":136},[14,768,769],{"class":66},"});\n",[14,771,772],{"class":62,"line":149},[14,773,328],{"emptyLinePlaceholder":327},[14,775,776,779,782,784,786,788,791,793,796,798,800,802,804,807,809,811],{"class":62,"line":162},[14,777,778],{"class":66},"sequence.",[14,780,781],{"class":231},"slice",[14,783,545],{"class":66},[14,785,199],{"class":73},[14,787,351],{"class":66},[14,789,790],{"class":224},"-",[14,792,195],{"class":73},[14,794,795],{"class":66},").",[14,797,342],{"class":231},[14,799,424],{"class":66},[14,801,711],{"class":243},[14,803,351],{"class":66},[14,805,806],{"class":243},"index",[14,808,429],{"class":66},[14,810,360],{"class":224},[14,812,279],{"class":66},[14,814,815,818,821,823,826,829,832],{"class":62,"line":173},[14,816,817],{"class":224},"  const",[14,819,820],{"class":73}," nextChord",[14,822,235],{"class":224},[14,824,825],{"class":66}," sequence[index ",[14,827,828],{"class":224},"+",[14,830,831],{"class":73}," 1",[14,833,834],{"class":66},"];\n",[14,836,837,839,842,845,848,851,854,856,859,861],{"class":62,"line":390},[14,838,463],{"class":224},[14,840,841],{"class":66}," (",[14,843,844],{"class":224},"!",[14,846,847],{"class":66},"nextChord ",[14,849,850],{"class":224},"||",[14,852,853],{"class":66}," chord ",[14,855,469],{"class":224},[14,857,858],{"class":66}," nextChord) ",[14,860,485],{"class":224},[14,862,296],{"class":66},[14,864,865,867],{"class":62,"line":405},[14,866,722],{"class":231},[14,868,725],{"class":66},[14,870,871],{"class":62,"line":411},[14,872,730],{"class":66},[14,874,875,878,880,883,886,888],{"class":62,"line":436},[14,876,877],{"class":548},"    `progression:${",[14,879,711],{"class":66},[14,881,882],{"class":548},"}>${",[14,884,885],{"class":66},"nextChord",[14,887,740],{"class":548},[14,889,83],{"class":66},[14,891,892,894,897,899,901,903],{"class":62,"line":450},[14,893,747],{"class":73},[14,895,896],{"class":66},".progression ",[14,898,500],{"class":224},[14,900,514],{"class":66},[14,902,506],{"class":231},[14,904,905],{"class":66},"(totalChordCount),\n",[14,907,908],{"class":62,"line":455},[14,909,764],{"class":66},[14,911,912],{"class":62,"line":460},[14,913,769],{"class":66},[19,915,917],{"id":916},"generating-the-most-similar-tabs","Generating the most similar tabs",[10,919,920],{},"We read our index of tabs, build one vector per song, and then compare each song against every other song.",[10,922,923],{},"In pseudocode:",[27,925,928],{"className":926,"code":927,"language":32,"meta":33},[30],"entries = read all songs and tabs\nvectors = build one vector per song/tab\n\nfor each song:\n  compare against every other song with cosine similarity\n  sort by score descending\n  keep the top 3\n\nwrite similarTabIds back to public/data/songs-index.json\nwrite detailed scores to public/data/similar-tabs.json\n",[35,929,927],{"__ignoreMap":33},[10,931,932,933,936],{},"The ",[35,934,935],{},"similarTabIds"," field is what the UI uses. Since the song index is already loaded by the app, rendering similar tabs does not require another request.",[19,938,940],{"id":939},"rendering-it","Rendering it",[10,942,943,944,947],{},"Once the IDs are embedded in ",[35,945,946],{},"songs-index.json",", the UI work is straightforward. The app looks up those IDs in the existing song index and passes the resulting songs to a small presentational component.",[10,949,950,951,351,954,957,958,961],{},"The sidebar shows the three similar tabs above the capo, voicing, and chord controls. I also strip tab suffixes like ",[35,952,953],{},"Chords",[35,955,956],{},"Chord",", and ",[35,959,960],{},"Chords Ver 3"," from the display title so the list reads more like song names than imported tab names.",[10,963,964],{},"When Spotify context includes album artwork, the recommendation shows a small album image next to the title.",[19,966,968],{"id":967},"future-improvements","Future improvements",[10,970,971],{},"There is still a lot of improvement to be had.",[10,973,974],{},"Right now the weights are hand-tuned, but I could imagine running some experiments to measure the impact of each weight, and better determine what is ideal here.",[10,976,977],{},"Additionally, we would definitely benefit from more metadata enrichment; what we currently have is pretty limited. Many songs are missing genre data, and when genre is missing the model has to fall back to release date, chords, and tab metadata.",[10,979,980],{},"Better results would likely come from adding things like: instrumentation tags, tempo or energy information, richer artist information, etc.",[10,982,983],{},"All-in-all, this feels like a good first version. The implementation is small, and it's really easy to re-build the embeddings with no external dependencies.",[985,986,987],"style",{},"html pre.shiki code .snl16, html code.shiki .snl16{--shiki-default:#F97583}html pre.shiki code .svObZ, html code.shiki .svObZ{--shiki-default:#B392F0}html pre.shiki code .s95oV, html code.shiki .s95oV{--shiki-default:#E1E4E8}html pre.shiki code .s9osk, html code.shiki .s9osk{--shiki-default:#FFAB70}html pre.shiki code .sDLfK, html code.shiki .sDLfK{--shiki-default:#79B8FF}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html pre.shiki code .sU2Wk, html code.shiki .sU2Wk{--shiki-default:#9ECBFF}html pre.shiki code .sAwPA, html code.shiki .sAwPA{--shiki-default:#6A737D}",{"title":33,"searchDepth":70,"depth":70,"links":989},[990,991,992,993,994,995,996],{"id":21,"depth":70,"text":22},{"id":42,"depth":70,"text":43},{"id":185,"depth":70,"text":186},{"id":528,"depth":70,"text":529},{"id":916,"depth":70,"text":917},{"id":939,"depth":70,"text":940},{"id":967,"depth":70,"text":968},null,[999,1000],"ml","web","2026-06-04T00:00:00.000Z","A new feature on [tabs.garden]tabs.garden just landed, where a user can see similar tab suggestions in the sidebar. This was implemented in a very simple way (spoiler: using JSON files and a rudimentary cosine-similarity score), but I was very pleased by the result.",false,"md",{"excerpt":1006},{"type":7,"value":1007},[1008],[10,1009,12,1010,17],{},[14,1011,16],{},"/blog/tabs-garden-tab-suggestions",{"title":5,"description":1002},"blog/tabs-garden-tab-suggestions",[999,1016,1017],"tabs","music","Av-VVaqtge2TW4GDX3QB4xqmJIFPUwfEgU2gbH-uehc",1780598496363]